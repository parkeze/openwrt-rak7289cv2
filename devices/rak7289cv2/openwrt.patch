diff --git a/target/linux/ramips/mt76x8/base-files/etc/init.d/modem_switch b/target/linux/ramips/mt76x8/base-files/etc/init.d/modem_switch
new file mode 100755
index 0000000000..d76a1b1045
--- /dev/null
+++ b/target/linux/ramips/mt76x8/base-files/etc/init.d/modem_switch
@@ -0,0 +1,14 @@
+#!/bin/sh /etc/rc.common
+
+START=15
+
+boot() {
+	case $(board_name) in
+	rakwireless,rak7289cv2)
+		# A wedged modem stays off USB, warm reboots included, until reset.
+		echo "1" > /sys/class/gpio/modem-reset/value
+		sleep 1
+		echo "0" > /sys/class/gpio/modem-reset/value
+		;;
+	esac
+}
